/*
 * Nokia G-2425G-A (Airtel XStream Fiber) - RAM-only (initramfs) profile
 * OpenWrt target: econet / en7528
 *
 * Hardware (verified on the live unit, see the project handoff):
 *   SoC   : EcoNet EN7528, 2x MIPS 1004Kc, 256 MB RAM
 *   Wi-Fi : MT7603E   on PCIe0 (2.4 GHz) - 14c3:7603
 *           MT7663    on PCIe1 (5 GHz)  - 14c3:7663 (mt7615 driver)
 *   NAND  : SPI-NAND, 128 KiB erase blocks, 256 MiB
 *   USB   : EN7528 xHCI, VBUS = GPIO14 (active high)
 *
 * This image is intended to be booted from RAM and must never write flash.
 * &nand is kept enabled so the per-unit MAC addresses can be read from the
 * "ri" partition, but it deliberately omits:
 *
 *   econet,can-write-factory-bbt   -> the en75_bmt driver then refuses to
 *                                     write/rebuild the bad-block table
 *   econet,enable-remap            -> read-time block remapping, i.e. a
 *                                     flash write on a plain read
 *
 * so the BMT driver only ever reads. Partition offsets are confirmed against
 * this unit's own kernel (handoff Round 14), not a sibling board.
 *
 * As defence in depth every partition is ALSO marked read-only, so even a stray
 * "mtd write" / "flashcp" from an interactive shell is refused at the MTD layer
 * (ofpart turns "read-only" into mask_flags |= MTD_WRITEABLE, which clears the
 * write permission). That keeps the whole flash - bootloader, both A/B image
 * slots, and the vendor "config"/"data" UBIFS - byte identical across a power
 * cycle. Drop the flags only for a planned flash install.
 *
 * "rootfs" deliberately does NOT carry "linux,rootfs". add_mtd_device()
 * (drivers/mtd/mtdcore.c) reads that property and sets the kernel's global
 * ROOT_DEV to the partition, i.e. "mount and boot user space from" it, which is
 * the opposite of what a RAM-only boot wants. Add it, together with a cmdline
 * "root=", only if this board is ever installed to flash.
 *
 * Known TODOs (handoff Rounds 15/20):
 *   - 5 GHz calibration is embedded as "mediatek,eeprom-data" on &slot1 (see the
 *     note there). The 2.4 GHz MT7603 needs none: it already reports a full
 *     20 dBm txpower from its own OTP/efuse (measured live).
 *   - LED / button GPIO map is only partly known: the LAN socket LEDs are now
 *     wired through the switch PHY pinctrl (see &pinctrl below), the single
 *     GPIO LED and the button candidates are still unverified.
 */

/dts-v1/;

#include "en7528.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Nokia G-2425G-A";
	compatible = "nokia,g2425g-a", "econet,en7528";

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>;	/* 256 MB */
	};

	chosen {
		stdout-path = "/serial@1fbf0000:115200";
		linux,usable-memory-range = <0x00020000 0x0ffe0000>;
	};

	/*
	 * Only one LED is driven by a plain GPIO on this board
	 * (/proc/tc3162/led_def: led 42 -> GPIO16). Polarity and the physical
	 * LED it lights are unverified, so no color/function is asserted and
	 * 01_leds attaches no trigger.
	 */
	leds {
		compatible = "gpio-leds";

		led_gpio16: led-16 {
			gpios = <&pinctrl 16 GPIO_ACTIVE_LOW>;
		};
	};

	/* USB port power: GPIO14, active high (vendor-confirmed). */
	reg_usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpios = <&pinctrl 14 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	/*
	 * Button candidates from the vendor's button_driver.ko table
	 * (handoff Round 15). Which is reset/WPS/WLAN is not known, so this is
	 * disabled until a physical press test identifies them.
	 */
	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;
		status = "disabled";

		key-gpio-17 {
			label = "gpio17";
			gpios = <&pinctrl 17 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PROG1>;
		};

		key-gpio-16 {
			label = "gpio16";
			gpios = <&pinctrl 16 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PROG2>;
		};

		key-gpio-11 {
			label = "gpio11";
			gpios = <&pinctrl 11 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PROG3>;
		};

		key-gpio-18 {
			label = "gpio18";
			gpios = <&pinctrl 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PROG4>;
		};
	};
};

/* ------------------------------- PCIe ------------------------------- */

&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";
};

/*
 * 2.4 GHz radio. MAC = ri[0x3e] + 9, matching the vendor ra0
 * (18:45:93:71:cd:09). Calibration EEPROM is a UBIFS file, see TODO above.
 */
&slot0 {
	status = "okay";

	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&macaddr_ri 9>;
		nvmem-cell-names = "mac-address";
		ieee80211-freq-limit = <2400000 2500000>;
	};
};

/*
 * 5 GHz radio (MT7663/MT7613, mt7615 driver). MAC = ri[0x3e] + 13,
 * matching the vendor rai0 (18:45:93:71:cd:0d).
 *
 * CALIBRATION (handoff Round 20).
 * Without a calibration source the mt7615 driver runs on chip defaults and
 * reports a flat 3 dBm limit on every 5 GHz channel (measured live), i.e. the
 * radio works but at ~2 mW. The calibration bitstream is a *file* on this
 * board (/configs/bin_ac/RT30xxEEPROM.bin, 1536 bytes), not a raw flash region,
 * so "mediatek,mtd-eeprom" is not usable. mt76 also understands
 * "mediatek,eeprom-data" (raw bytes in the DT), which is what we use: the file
 * is embedded verbatim at build time.
 *
 * Why this file is the right one, and is safe to embed:
 *   - size 1536 == MT7663_EEPROM_SIZE (mt7615/mt7615.h)
 *   - offset 0x00 holds the chip id 0x7663, which is exactly what
 *     mt7615_check_eeprom() accepts (0x7615 / 0x7622 / 0x7663)
 *   - offset 0x04 holds the MAC (00:0c:43:26:60:00 - a MediaTek OUI, not this
 *     unit's MAC), and MT_EE_MAC_ADDR == 0x004
 *   - offset 0x0c holds 0x14c3 (MediaTek PCI vendor id)
 * mt76_get_of_eeprom_data() only requires size <= the buffer it asks for
 * (MT7615_EEPROM_FULL_SIZE), so a 1536-byte property is accepted.
 * The interface MACs still come from nvmem-cells above: mt76_eeprom_override()
 * prefers the DT mac-address over whatever the EEPROM contains.
 *
 * Source file: board/nokia-mt7663-eeprom.bin (md5 3086e97e75a3c8d7248499543e4a374b),
 * extracted read-only from this unit's config UBIFS (mtd6 /configs).
 */
&slot1 {
	status = "okay";

	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&macaddr_ri 13>;
		nvmem-cell-names = "mac-address";
		ieee80211-freq-limit = <5000000 6000000>;
		mediatek,eeprom-data = /incbin/("nokia-mt7663-eeprom.bin");
	};
};

/* ----------------------------- Ethernet ----------------------------- */

&gmac0 {
	status = "okay";
	nvmem-cells = <&macaddr_ri 0>;
	nvmem-cell-names = "mac-address";
};

/*
 * The EN7528 switch has no DSA support upstream yet; the four LAN sockets are
 * plain switch ports. Port -> socket numbering is taken from the DASAN/Jio
 * convention (port 1 = LAN1) and is not independently verified on this board.
 */
&switch {
	status = "okay";
};

&gsw_port1 {
	label = "lan1";
	status = "okay";
};

&gsw_port2 {
	label = "lan2";
	status = "okay";
};

&gsw_port3 {
	label = "lan3";
	status = "okay";
};

&gsw_port4 {
	label = "lan4";
	status = "okay";
};

/*
 * LAN socket LEDs.
 *
 * The four RJ45 LEDs are switch-PHY LEDs (gsw_phyN_ledM in en7528.dtsi), not
 * GPIOs, and they need two independent things to work:
 *
 *   1. the pad must be muxed to the PHY LED function, i.e. the "gbe-led"
 *      pinctrl state must exist. When it did not, the driver logged
 *      "Failed to setup PHY LED pinctrl" once per PHY and the active-low pins
 *      floated, so every LED sat lit.
 *
 *   2. the led@N child of the PHY must be "okay". phylib only walks *available*
 *      children (of_phy_leds() in drivers/net/phy/phy_device.c), and every leds
 *      node in en7528.dtsi is "disabled". With them disabled nothing ever
 *      programs the PHY LED registers, so the LEDs keep their reset state -
 *      which, now that the pads are muxed, means lit. (CONFIG_PHYLIB_LEDS is
 *      already =y in target/linux/econet/en7528/config-6.18.)
 *
 * fn = LED colour of the led@N classdev: phylib names it
 * "<mdio dev>:<color>:<function>", e.g. "mt7530-0:09:green:lan". 03_nokia-board
 * points a netdev trigger at each of those names.
 *
 * The EN7528 pinctrl is a crossbar: every LANk pad can show the LED state of
 * any of the four PHYs (LANk_PHY_LED_MAP(n)). The identity mapping below
 * (PHY n -> pad n) is a GUESS and is not verified on this unit; if a socket's
 * LED follows a different socket, swap the pad numbers here.
 *
 * gpio30/32/34/36 are the LANk_LED0 pads, gpio31/33/35/37 the LANk_LED1 pads
 * (pinctrl-en7528, datasheet table 4-12). Both banks are muxed because it is
 * not known yet which one is fitted in the sockets. Nothing else on this board
 * uses gpio30..37: the button candidates are 11/16/17/18, USB VBUS is 14 and
 * the GPIO LED is 16.
 */
&pinctrl {
	gswp1_led0_pins: gswp1-led0-pins {
		mux {
			function = "phy1_led0";
			groups = "gpio30";
		};
	};

	gswp1_led1_pins: gswp1-led1-pins {
		mux {
			function = "phy1_led1";
			groups = "gpio31";
		};
	};

	gswp2_led0_pins: gswp2-led0-pins {
		mux {
			function = "phy2_led0";
			groups = "gpio32";
		};
	};

	gswp2_led1_pins: gswp2-led1-pins {
		mux {
			function = "phy2_led1";
			groups = "gpio33";
		};
	};

	gswp3_led0_pins: gswp3-led0-pins {
		mux {
			function = "phy3_led0";
			groups = "gpio34";
		};
	};

	gswp3_led1_pins: gswp3-led1-pins {
		mux {
			function = "phy3_led1";
			groups = "gpio35";
		};
	};

	gswp4_led0_pins: gswp4-led0-pins {
		mux {
			function = "phy4_led0";
			groups = "gpio36";
		};
	};

	gswp4_led1_pins: gswp4-led1-pins {
		mux {
			function = "phy4_led1";
			groups = "gpio37";
		};
	};
};

&gsw_phy1 {
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp1_led0_pins &gswp1_led1_pins>;
};

&gsw_phy2 {
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp2_led0_pins &gswp2_led1_pins>;
};

&gsw_phy3 {
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp3_led0_pins &gswp3_led1_pins>;
};

&gsw_phy4 {
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp4_led0_pins &gswp4_led1_pins>;
};

/*
 * led0 = the "link/activity" LED of each socket, led1 = the speed LED, by the
 * usual MediaTek board convention. Unverified here, and harmless if the wrong
 * way round: both end up following their PHY's link state.
 *
 * "active-low" is REQUIRED on this board and was the fix for the inverted LED
 * behaviour seen on the v4 image (idle = lit, link up = dark).  It is set from
 * the observed reset state: with the pads muxed, the LED block powers up with
 * its registers cleared and all four sockets lit with no cable, i.e. the fitted
 * LEDs are common-anode and the PHY pin sinks current to light them.  The
 * driver's default polarity is active-high, so the netdev trigger's "off"
 * (link down) drove the pin low -> lit, and "on" (link up) drove it high ->
 * dark.  "active-low" makes of_phy_led() call an7581_phy_led_polarity_set()
 * with PHY_LED_ACTIVE_LOW, which sets MTK_PHY_LED_ON_POLARITY (BIT 14) in the
 * per-LED ON_CTRL register (mtk-ge-soc.c), so "on" now means pin low = lit.
 */
&gsw_phy1_led0 {
	status = "okay";
	active-low;
	function = LED_FUNCTION_LAN;
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy1_led1 {
	status = "okay";
	active-low;
	function = LED_FUNCTION_LAN;
	color = <LED_COLOR_ID_AMBER>;
};

&gsw_phy2_led0 {
	status = "okay";
	active-low;
	function = LED_FUNCTION_LAN;
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy2_led1 {
	status = "okay";
	active-low;
	function = LED_FUNCTION_LAN;
	color = <LED_COLOR_ID_AMBER>;
};

&gsw_phy3_led0 {
	status = "okay";
	active-low;
	function = LED_FUNCTION_LAN;
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy3_led1 {
	status = "okay";
	active-low;
	function = LED_FUNCTION_LAN;
	color = <LED_COLOR_ID_AMBER>;
};

&gsw_phy4_led0 {
	status = "okay";
	active-low;
	function = LED_FUNCTION_LAN;
	color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy4_led1 {
	status = "okay";
	active-low;
	function = LED_FUNCTION_LAN;
	color = <LED_COLOR_ID_AMBER>;
};


/* ------------------------------ USB --------------------------------- */

&usb {
	status = "okay";
	vbus-supply = <&reg_usb_vbus>;
};

/* ------------------------------ Flash ------------------------------- */
/*
 * READ-ONLY configuration. Do NOT add econet,can-write-factory-bbt or
 * econet,enable-remap: both can cause flash writes during normal operation.
 *
 * Layout confirmed in handoff Round 14 from this unit's own kernel partition
 * table (every region after "bootloader" is MTDPART_OFS_APPEND, so offsets are
 * the cumulative sum of the sizes). ubi0=config, ubi1=log, ubi2=data(/flash).
 *
 * Every partition below is read-only, which makes the "never write flash" rule
 * structural rather than a matter of discipline. This also matches what the
 * vendor kernel does anyway - its boot log prints
 *   mtd: partition "rootfs" doesn't start on an erase/write block boundary
 *   -- force read-only
 * because "rootfs" sits at linux+0x3defb8 and is not erase-block aligned.
 */
&nand {
	status = "okay";
	econet,bmt;
	econet,bbt-table-size = <250>;

	partitions: partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bootloader";
			reg = <0x0 0x40000>;
			read-only;
		};

		partition@40000 {
			label = "romfile";
			reg = <0x40000 0x40000>;
			read-only;
		};

		/* image slot A (vendor version 3FE49362IJHK03) */
		partition@80000 {
			label = "image0";
			reg = <0x80000 0x2200000>;
			read-only;
		};

		/* image slot B, currently active (3FE49362IJHK33) */
		partition@2280000 {
			label = "linux";
			reg = <0x2280000 0x2200000>;
			read-only;
		};

		/*
		 * Derived by the vendor kernel from the active image header and
		 * nested inside "linux", so the two overlap by design. read-only
		 * because the vendor kernel forces that anyway (it is not on an
		 * erase-block boundary); no "linux,rootfs" - see the header note.
		 */
		partition@265efb8 {
			label = "rootfs";
			reg = <0x265efb8 0x1e21048>;
			read-only;
		};

		/* offline/factory recovery image (3FE49107AGDA19) */
		partition@4480000 {
			label = "image_oflt";
			reg = <0x4480000 0xf00000>;
			read-only;
		};

		partition@5380000 {
			label = "config";
			reg = <0x5380000 0x800000>;
			read-only;
		};

		partition@5b80000 {
			label = "log";
			reg = <0x5b80000 0xc00000>;
			read-only;
		};

		partition@6780000 {
			label = "extfs";
			reg = <0x6780000 0x600000>;
			read-only;
		};

		partition@6d80000 {
			label = "bosa";
			reg = <0x6d80000 0x40000>;
			read-only;
		};

		partition@6dc0000 {
			label = "flag";
			reg = <0x6dc0000 0x40000>;
			read-only;
		};

		partition@6e00000 {
			label = "flagback";
			reg = <0x6e00000 0x40000>;
			read-only;
		};

		partition@6e40000 {
			label = "ri";
			reg = <0x6e40000 0x40000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				/*
				 * Base MAC at ri[0x3e]. Observed interface MACs:
				 *   +0   eth0/br0
				 *   +9   ra0  (2.4 GHz)
				 *   +13  rai0 (5 GHz)
				 */
				macaddr_ri: macaddr@3e {
					compatible = "mac-base";
					reg = <0x3e 0x6>;
					#nvmem-cell-cells = <1>;
				};
			};
		};

		partition@6e80000 {
			label = "riback";
			reg = <0x6e80000 0x40000>;
			read-only;
		};

		/* UBI (mtd14 -> ubi2, mounted at /flash by the vendor firmware) */
		partition@6ec0000 {
			label = "data";
			reg = <0x6ec0000 0x6e00000>;
			read-only;
		};
	};
};
