#!/bin/sh
#
# Nokia G-2425G-A board defaults.
#
# Installed as /etc/board.d/03_nokia-board by build.sh, so it runs at boot with
# the same mechanism as the target's 01_leds / 02_network.  It is deliberately
# additive: it never redefines an interface (that is what the 02_network patch
# in build.sh is for), it only contributes board.json keys.
#
. /lib/functions.sh
. /lib/functions/uci-defaults.sh

board_config_update

if [ "$(board_name)" = "nokia,g2425g-a" ]; then
	#
	# Regulatory domain.
	#
	# The wireless config generator disables every non-2.4 GHz radio when it has
	# no country for the board:
	#     /lib/wifi/mac80211.uc:  if (!country && band_name != '2g')
	#                                 defaults = null;   ->  disabled='1'
	# which is why the 5 GHz AP is missing on a fresh boot.  This is an Airtel
	# (India) unit, so IN.  Change it here if the router is used elsewhere.
	#
	ucidef_set_country "IN"

	#
	# Wireless APs enabled at boot.
	#
	# mac80211.uc decides the generated wifi-iface's disabled flag from whether
	# board.json has wlan.defaults.ssids for the band:
	#     set ${si}.disabled='${defaults ? 0 : 1}'
	# so without this every default_radioN is written disabled='1' and no AP
	# comes up (the running v4 image's symptom).  ucidef_set_wireless writes
	# wlan.defaults.ssids.<band>, which makes the generator emit the AP as
	# disabled='0' with the SSID/encryption/key below - directly at config
	# generation time, with no dependence on uci-defaults ordering.
	#
	# This is why the AP enabling moved out of 99_nokia-settings: in this image
	# /etc/config/wireless is (re)generated by the wifi detect hotplug, which can
	# run after uci-defaults, so edits made there were being overwritten and the
	# APs stayed down.  board.json is read by the generator itself, so it cannot
	# lose the race.
	#
	# WPA2-PSK with CCMP (AES) only: "psk2+ccmp" excludes TKIP and WPA1/WPA2
	# mixed mode, so there is no downgrade path to TKIP.
	#
	# NOTE: this passphrase is committed to a public repository and is therefore
	# also inside the published initramfs.  It is a test credential for a RAM-only
	# boot; do not reuse a key that protects anything real.  To keep it out of the
	# tree, pass it in from the workflow as a secret and substitute it in build.sh.
	#
	WIFI_KEY="mycurrentpasswordforopenwrt"
	ucidef_set_wireless "2g" "OpenWrt"    "psk2+ccmp" "$WIFI_KEY"
	ucidef_set_wireless "5g" "OpenWrt_5G" "psk2+ccmp" "$WIFI_KEY"

	#
	# LAN address.
	#
	# This is an ONT that shipped as 192.168.100.1 (the vendor's /configs/br0_ip_addr),
	# and its sticker/DHCP expectations are built around that, so keep the stock LAN
	# subnet instead of the target default 192.168.1.1.  Only board.json keys are
	# added here; config_generate turns them into network.lan.ipaddr='192.168.100.1/24'.
	# The DHCP pool is adjusted to match in 99_nokia-settings.
	#
	ucidef_set_interface "lan" ipaddr "192.168.100.1" netmask "255.255.255.0"

	#
	# LAN socket LEDs.
	#
	# The four RJ45 LEDs hang off the MT7530/EN7528 GPHY LED blocks, not GPIOs.
	# phylib registers them from the DTS led@N nodes (enabled in this board's
	# .dts) and names them "<mdio dev>:<color>:<function>", so on this unit:
	#
	#     mt7530-0:09:green:lan   (LED0)   mt7530-0:09:amber:lan   (LED1)
	#
	# with 9..c being the PHYs of lan1..lan4 (dmesg prints
	# "lan4 (uninitialized): PHY [mt7530-0:0c]").  Attach a netdev trigger to
	# each; pointing it at the PHY's own netdev also lets the netdev trigger
	# validate hw control and offload link/activity to the PHY itself.
	#
	idx=9
	for lan in 1 2 3 4; do
		phy=$(printf '%02x' "$idx")
		ucidef_set_led_netdev "lan$lan" "lan$lan" \
			"mt7530-0:$phy:green:lan" "lan$lan" "link tx rx"
		ucidef_set_led_netdev "lan${lan}_1" "lan$lan" \
			"mt7530-0:$phy:amber:lan" "lan$lan" "link tx rx"
		idx=$((idx + 1))
	done

	#
	# WLAN LEDs.
	#
	# 2.4 GHz: the MT7603's own LED output, registered by mt76 as the classdev
	# "mt76-phy0".  Its driver default trigger is phy0tpt (throughput), so it is
	# dark whenever there is no traffic; "phy0radio" makes it steady-on while the
	# radio is up, which is what a front-panel WLAN LED should do.  Confirmed on
	# the live v4 RAM boot: with phy0radio the classdev reads brightness=255 as
	# soon as phy0-ap0 is up.
	#
	# 5 GHz: mt76 registers "mt76-phy1" as well, but this board's 5 GHz
	# front-panel LED is NOT on the MT7663's LED output - it hangs off the SoC TC
	# LED engine (~0x1fbf0xxx) which has no Linux driver (handoff R21).  Pointing
	# phy1radio at it is inert on this hardware; it is kept so the classdev has a
	# sane trigger and would work if that LED is ever re-mapped.
	#
	ucidef_set_led_wlan "wlan2" "wlan2" "mt76-phy0" "phy0radio"
	ucidef_set_led_wlan "wlan5" "wlan5" "mt76-phy1" "phy1radio"
fi

board_config_flush

exit 0
