#!/bin/sh
#
# Nokia G-2425G-A: post-config defaults that /etc/board.json cannot express.
#
# Installed as /etc/uci-defaults/99_nokia-settings by build.sh.  uci-defaults
# run from /etc/init.d/boot, i.e. after /bin/config_generate has written
# /etc/config/{network,system} and before network/wifi come up, so editing
# /etc/config/dhcp and /etc/config/wireless here takes effect on the first boot.
#
. /lib/functions.sh

[ "$(board_name)" = "nokia,g2425g-a" ] || exit 0

#
# LAN address check.
#
# 03_nokia-board puts ipaddr/netmask in /etc/board.json and config_generate
# turns that into network.lan.ipaddr.  Verify it actually arrived (a silent
# mismatch here would leave the box on 192.168.1.1 and the DHCP pool below
# pointing at the wrong subnet) and fix it up if it did not.
#
if [ "$(uci -q get network.lan.ipaddr)" != "192.168.100.1/24" ]; then
	echo 'nokia: network.lan.ipaddr was not applied from board.json, setting it here'
	uci -q set network.lan.ipaddr='192.168.100.1/24'
	uci -q delete network.lan.netmask
	uci -q commit network
fi

#
# DHCP pool for the 192.168.100.0/24 LAN, i.e. 192.168.100.100-249.
# dnsmasq's shipped /etc/config/dhcp already uses start=100/limit=150, which
# would land there by itself; set it explicitly so the pool does not depend on
# that package default changing.
#
uci -q set dhcp.lan.start='100'
uci -q set dhcp.lan.limit='150'
uci -q commit dhcp

#
# Enable the default AP on every radio, and give the 5 GHz one its own SSID.
#
# Upstream's wifi config generator always writes the "default_radioN" wifi-iface
# with disabled='1' (and, for bands other than 2.4 GHz, the whole default only
# exists once a regulatory country is known - 03_nokia-board sets that).  For a
# RAM test box the point is to have Wi-Fi usable straight after boot, so flip
# them on.
#
# Both radios would otherwise be called "OpenWrt", which makes it impossible to
# tell from a client which band it associated with; suffix the 5 GHz one.
#
# WPA2-PSK with CCMP (AES) only: "psk2+ccmp" excludes TKIP and the WPA1/WPA2
# mixed mode, so there is no downgrade path to TKIP.
#
# NOTE: this passphrase is committed to a public repository and is therefore
# also inside the published initramfs.  It is a test credential for a RAM-only
# boot; do not reuse a key that protects anything real.  To keep it out of the
# tree, pass it in from the workflow as a secret and substitute it in build.sh.
#
WIFI_KEY='mycurrentpasswordforopenwrt'

[ -f /etc/config/wireless ] || /sbin/wifi config

for s in $(uci -q show wireless |
	sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
	radio=$(uci -q get "wireless.$s.device")
	[ -n "$radio" ] || continue
	[ "$(uci -q get "wireless.$radio.band")" = "5g" ] &&
		uci -q set "wireless.$s.ssid='OpenWrt_5G'"
	uci -q set "wireless.$s.encryption='psk2+ccmp'"
	uci -q set "wireless.$s.key='$WIFI_KEY'"
	uci -q set "wireless.$s.disabled='0'"
done
uci -q commit wireless

exit 0
